# Copia este archivo como .env y reemplaza 192.168.1.50 por la IP de tu PC en la red Wi-Fi.
EXPO_PUBLIC_AUTH_URL=http://192.168.1.50:8081
EXPO_PUBLIC_INCIDENTS_URL=http://192.168.1.50:8082
EXPO_PUBLIC_EVIDENCES_URL=http://192.168.1.50:8083
EXPO_PUBLIC_NOTIFICATIONS_URL=http://192.168.1.50:8084
EXPO_PUBLIC_AI_CONFIDENCE_THRESHOLD=0.5
# Correo de la mesa de ayuda (opcional).
EXPO_PUBLIC_SUPPORT_EMAIL=
# Solo para el APK de la demo: dirección única del servidor (reemplaza las cuatro de arriba).
# EXPO_PUBLIC_API_URL=https://viadeep-tesis.eastus.cloudapp.azure.com
